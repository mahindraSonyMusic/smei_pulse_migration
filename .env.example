# Environment Variables for dbt RDS Boundary Connection
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control!

# Database Connection (via Boundary proxy)
DBT_HOST=127.0.0.1
DBT_PORT=5432
DBT_USER=your_username
DBT_PASSWORD=your_password
DBT_DATABASE=your_database_name
DBT_SCHEMA=public

# Environment-specific schemas
DBT_SCHEMA_STAGING=staging
DBT_SCHEMA_PROD=analytics

# Boundary Configuration
BOUNDARY_ADDR=https://your-boundary-cluster.example.com
BOUNDARY_TARGET_ID=ttcp_xxxxxxxxxxxx
BOUNDARY_AUTH_METHOD_ID=ampw_xxxxxxxxxxxx

# Optional: Boundary token (if using token auth)
# BOUNDARY_TOKEN=your_boundary_token
